# ─── App ───────────────────────────────────────────────────────────────
# Public URL of the app (used for OAuth callback and links in emails/Slack).
APP_URL=http://localhost:3000
# Long random string. Signs local upload URLs. `openssl rand -hex 32`
APP_SECRET=change-me-to-a-long-random-string

# ─── Database ──────────────────────────────────────────────────────────
# Leave empty to use the built-in embedded Postgres (PGlite) stored in .data/.
# For production, point at any Postgres (Supabase, Neon, RDS...).
DATABASE_URL=

# ─── Sign-in ───────────────────────────────────────────────────────────
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Anyone with a verified Google email on these domains can sign in (comma-separated).
# Others can sign in only if an admin has added them under Admin → People.
ALLOWED_EMAIL_DOMAINS=yourcompany.com
# These emails are always admins (comma-separated).
ADMIN_EMAILS=
# Pick-a-user login with no password. Local development and demos ONLY.
ALLOW_DEV_LOGIN=true

# ─── File storage ──────────────────────────────────────────────────────
# "local" stores files in .data/uploads. "s3" works with Cloudflare R2, AWS S3, etc.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=2048

# ─── Notifications (all optional) ──────────────────────────────────────
# Slack incoming webhook: one message per event in a shared channel.
SLACK_WEBHOOK_URL=
# SMTP for email notifications. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Creative Tracker <tracker@yourcompany.com>"
